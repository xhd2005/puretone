{
  "name": "puretone",
  "version": "2.4.10",
  "private": true,
  "description": "MELUNE (弥音) - Minimalist ad-free iOS 26 Liquid Glass Android music player with built-in KuGou API, 4-channel unblock engine, and Daily VIP Auto-Claim.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "pnpm build && npx cap sync android",
    "apk:debug": "pnpm cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.11",
    "@capacitor/core": "^7.6.11",
    "@iconify/icons-tabler": "^1.2.95",
    "@iconify/vue": "^5.0.0",
    "axios": "^1.8.4",
    "big-integer": "^1.6.52",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "node-forge": "^1.3.1",
    "pako": "^2.1.0",
    "pinia": "^3.0.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.11",
    "@tailwindcss/vite": "^4.1.4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.15.0",
    "@types/node-forge": "^1.3.11",
    "@types/pako": "^2.0.3",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "vue-tsc": "^2.2.10"
  }
}

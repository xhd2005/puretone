<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic Album-Tinted Liquid Glass Gradient Backdrop -->
    <ImageView
        android:id="@+id/widget_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Brand & Live Playback Status Micro-Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_stat_puretone" />

                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="#9EFFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#FFFFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_subtitle"
                android:textColor="#B8FFFFFF"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/widget_btn_bg"
                    android:contentDescription="Previous"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_prev" />

                <ImageButton
                    android:id="@+id/widget_btn_play"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/widget_btn_bg"
                    android:contentDescription="Play or Pause"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_play" />

                <ImageButton
                    android:id="@+id/widget_btn_next"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/widget_btn_bg"
                    android:contentDescription="Next"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_next" />

                <ImageButton
                    android:id="@+id/widget_btn_fav"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/widget_btn_bg"
                    android:contentDescription="Favorite"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_heart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base Diagonal Fluid Gradient: Rose-Crimson -> Plum-Violet -> Deep Obsidian -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12"
                android:startY="8"
                android:endX="98"
                android:endY="102">
                <item android:color="#FFFA243C" android:offset="0.0" />
                <item android:color="#FFC91F6B" android:offset="0.38" />
                <item android:color="#FF6B1D5C" android:offset="0.72" />
                <item android:color="#FF1E1030" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upper-Left Liquid Glass Glow Orb -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="28"
                android:centerY="24"
                android:gradientRadius="62">
                <item android:color="#88FF6B81" android:offset="0.0" />
                <item android:color="#22FF375F" android:offset="0.55" />
                <item android:color="#00FA243C" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lower-Right Velvet Violet Aura -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="84"
                android:centerY="84"
                android:gradientRadius="56">
                <item android:color="#669333EA" android:offset="0.0" />
                <item android:color="#001E1030" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

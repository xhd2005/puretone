<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- MELUNE Deep Moonlit Indigo-Sapphire Liquid Glass Gradient -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="19"
                android:startY="0"
                android:endX="89"
                android:endY="108">
                <item android:color="#FF3456BE" android:offset="0.0" />
                <item android:color="#FF1A2D70" android:offset="0.48" />
                <item android:color="#FF0B1336" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft Lunar Top Ambient Glow -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="37"
                android:centerY="15"
                android:gradientRadius="65">
                <item android:color="#60A6CCFF" android:offset="0.0" />
                <item android:color="#186A95F7" android:offset="0.48" />
                <item android:color="#006A95F7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Twilight Violet Rim Sheen -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="91"
                android:centerY="93"
                android:gradientRadius="56">
                <item android:color="#427B6BFF" android:offset="0.0" />
                <item android:color="#007B6BFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
